        "quantity": 10,
        "customerName": "Jane Smith",
        "customerEmail": "jane.smith@example.com",
        "shippingAddress": "456 Oak Avenue, Chicago, IL 60601",
        "paymentMethod": "DEBIT_CARD"
      }
    },
    {
      "description": "Valid Order Request - UPI Payment",
      "request": {
